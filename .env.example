# --- AI provider ---------------------------------------------------------
# "firebase" = Firebase AI Logic (Gemini Developer API backend)  [default when Firebase config is present]
# "genai"    = @google/genai directly with VITE_GEMINI_API_KEY   [fallback]
VITE_AI_PROVIDER=firebase
VITE_GEMINI_MODEL=gemini-3.8-flash
# Only needed when VITE_AI_PROVIDER=genai (key is exposed to the browser — demo only!)
VITE_GEMINI_API_KEY=

# --- Firebase web config (Project settings → Your apps → Web app) -------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
